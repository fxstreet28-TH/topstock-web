# ===========================================================================
# REQUIRED — the MVP deploys with only these four.
#
# The site is marketing-only: visitors read it and contact us on LINE. No
# database, no email service, no payment integration is needed to go live.
# ===========================================================================
NEXT_PUBLIC_LINE_ID=@aurumtech
NEXT_PUBLIC_LINE_QR_URL=https://line.me/R/ti/p/@aurumtech
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/aurumtech_support
NEXT_PUBLIC_SUPPORT_EMAIL=support@topstock.aurumtech.co

# Recommended: sets canonical and Open Graph URLs. Defaults to the production
# domain when unset, so a preview deploy works without it.
NEXT_PUBLIC_SITE_URL=https://topstock.aurumtech.co


# ===========================================================================
# OPTIONAL — only needed to turn the /trial form on.
#
# /trial is a secondary path. Leave these unset and the form returns a clear
# "message us on LINE instead" response rather than failing silently; every
# other page is unaffected. Add them when lead volume justifies a database.
# ===========================================================================

# Supabase — stores trial requests. Server-side only; the service role key
# bypasses row level security and must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — emails new leads to the admin. Without these the lead is still
# stored; only the alert is skipped, and that is logged.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
NOTIFICATION_FROM_EMAIL=Topstock <noreply@topstock.aurumtech.co>


# ===========================================================================
# OPTIONAL — later phases
# ===========================================================================

# Manual payment details, shown on the payment page (Phase 4).
PROMPTPAY_ID=
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# A Stripe payment link created by hand in the dashboard for international
# buyers. There is no on-site checkout (Phase 5).
STRIPE_PAYMENT_LINK_TOPSTOCK=

# Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=topstock.aurumtech.co
